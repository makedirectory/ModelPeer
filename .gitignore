.DS_Store
*.swp
*.tmp

# Never commit secrets. Model Peer itself reads no credentials, but a contributor's
# scratch environment file must not reach a public repository.
.env
.env.*
!.env.example

# Docs site
node_modules/
documentation/build/
documentation/.docusaurus/
documentation/.cache-loader/

# Agent directories. This project runs `model-peer init` on itself, so the skills
# and commands below are the ones Model Peer installs — dogfooded here, and
# checked against `model-peer init --print` by `make check-sync`. Everything else
# under these directories is local session state.
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**

.codex/*
!.codex/skills/
!.codex/skills/**

.gemini/*
!.gemini/skills/
!.gemini/skills/**

# Specs
specs/